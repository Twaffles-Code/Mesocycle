{
  // Tests run in Node (via vitest), not the browser, so they get Node's types.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
